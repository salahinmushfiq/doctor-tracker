# Public (browser-visible) - never put secrets in NEXT_PUBLIC_* variables.
# Base URL of the Express API including the version prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Same-origin proxy (recommended when the API is on a different site, e.g. Netlify/Vercel + Render).
# Server-side only (not NEXT_PUBLIC). Set it, then use NEXT_PUBLIC_API_BASE_URL=/api/v1 and COOKIE_SAMESITE=lax on the API.
# API_PROXY_TARGET=https://your-api.onrender.com
