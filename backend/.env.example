# ── Runtime ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/doctor_tracker
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker
MONGO_MAX_POOL_SIZE=10

# ── Auth ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN_MINUTES=60
JWT_ISSUER=doctor-tracker-api
JWT_AUDIENCE=doctor-tracker-web

# ── CORS / cookies ──────────────────────────────────────────────────────
# Comma-separated list of exact browser origins allowed to call the API.
FRONTEND_URL=http://localhost:3000
# lax    -> frontend and API are same-site (localhost, or API proxied through the frontend)
# none   -> frontend and API are on different sites (e.g. vercel.app + onrender.com); requires Secure
COOKIE_SAMESITE=lax
# Defaults to true in production, false otherwise.
COOKIE_SECURE=false
# Leave empty unless you need a shared parent domain.
COOKIE_DOMAIN=

# Number of reverse proxies in front of the app (Render = 1). Needed for correct client IPs.
TRUST_PROXY=0

# ── Seed script only (never read by the server) ─────────────────────────
# Provide via environment or CLI flags when running `npm run seed:admin`.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrator
